                                 },
                        "configuration":  {
                                              "properties":  {
                                                                 "apiKey":  {
                                                                                "type":  "string",
                                                                                "title":  "DeepSeek API Key",
                                                                                "description":  "用于查询余额的 API Key，仅保存在本机，只调用官方余额接口。请求次数与 Tokens 由本机账本统计，无需配置。建议使用专用 key。",
                                                                                "default":  "",
                                                                                "sensitive":  true,
                                                                                "ui":  {
                                                                                           "control":  "text"
                                                                                       }
                                                                            },
                                                                 "refreshIntervalSeconds":  {
                                                                                                "type":  "integer",
                                                                                                "title":  "自动刷新间隔（秒）",
                                                                                                "description":  "侧边栏自动拉取余额的间隔，默认 60（每分钟一次），0 表示关闭自动刷新。",
                                                                                                "default":  60,
                                                                                                "ui":  {
                                                                                                           "control":  "number"
                                                                                                       }
                                                                                            },
                                                                 "alertThreshold":  {
                                                                                        "type":  "number",
                                                                                        "title":  "余额预警阈值（元）",
                                                                                        "description":  "当总余额低于该金额时，侧边栏显示预警提示。0 表示关闭预警。",
                                                                                        "default":  0,
                                                                                        "ui":  {
                                                                                                   "control":  "number"
                                                                                               }
                                                                                    },
                                                                 "alertNotify":  {
                                                                                     "type":  "boolean",
                                                                                     "title":  "余额不足时允许推送通知",
                                                                                     "description":  "余额低于预警阈值时，允许通过「余额预警」工具把提醒发给定时任务/对话，再由宿主的通知通道投递到微信等平台（无需打开侧边栏）。",
                                                                                     "default":  true
                                                                                 },
                                                                 "eventPromptEnabled":  {
                                                                                            "type":  "boolean",
                                                                                            "title":  "余额变动提示",
                                                                                            "description":  "检测到充值、退款或赠金到账时，在侧边栏给出一条信息性提示（金额已按推断值自动入账，无需确认）。关闭后不再提示（累计数仍自动维护）。",
                                                                                            "default":  true
                                                                                        },
                                                                 "priceOverrides":  {
                                                                                        "type":  "string",
                                                                                        "title":  "单价覆盖表（元/百万，空闲价）",
                                                                                        "description":  "每行一条：「型号或前缀*=命中/未命中/输出」，# 开头为注释。例：deepseek-v5=1/8/24 或 deepseek-v5-*=1/8/24（前缀族匹配）。用于官方改价/新增型号时就地修正，无需改代码；留空则用内置价目表。未收录的型号会在用量详情页提示，且其金额不计入合计。",
                                                                                        "default":  ""
                                                                                    },
                                                                 "costCalibration":  {
                                                                                         "type":  "number",
                                                                                         "title":  "金额估算校准系数",
                                                                                         "description":  "通常保持 1；token 估算已与官方账单核对过，不再需要全局拟合系数。",
                                                                                         "default":  1,
                                                                                         "ui":  {
                                                                                                    "control":  "number"
                                                                                                }
                                                                                     },
                                                                 "usageBaselineRequests":  {
                                                                                               "type":  "integer",
                                                                                               "title":  "累计请求次数基准（补历史）",
                                                                                               "description":  "重装/清账之前已经发生、本机账本无从统计的累计请求次数。累计口径 = 基准 + 官方同步 + 本机账本（官方未覆盖部分）。0 表示不校正。",
                                                                                               "default":  0,
                                                                                               "ui":  {
                                                                                                          "control":  "number"
                                                                                                      }
                                                                                           },
                                                                 "usageBaselineTokens":  {
                                                                                             "type":  "integer",
                                                                                             "title":  "累计 Tokens 基准（补历史）",
                                                                                             "description":  "同上，用于累计 Tokens 的历史补正。0 表示不校正。",
                                                                                             "default":  0,
                                                                                             "ui":  {
                                                                                                        "control":  "number"
                                                                                                    }
                                                                                         },
                                                                 "timezoneOffsetMinutes":  {
                                                                                               "type":  "number",
                                                                                               "title":  "展示时区（分钟，内部字段）",
                                                                                               "description":  "侧边栏「选择时区」菜单写入的值，-1 表示跟随本机时区。只影响用量图表的日期/时段划分，不影响高峰价判定（后者始终按北京时间）。",
                                                                                               "default":  -1,
                                                                                               "ui":  {
                                                                                                          "control":  "number"
                                                                                                      }
                                                                                           },
                                                                 "totalRecharged":  {
                                                                                        "type":  "number",
                                                                                        "title":  "累计充值总额（元）",
                                                                                        "description":  "你在 DeepSeek 累计充值的总额，用于计算自有资金净支出。检测到充值（充值余额较上次增加 ≥1 元）时自动累加（金额按整元吸附，官方只允许充正整数），可随时手工校正。",
                                                                                        "default":  0,
                                                                                        "ui":  {
                                                                                                   "control":  "number"
                                                                                               }
                                                                                    },
                                                                 "totalRefunded":  {
                                                                                       "type":  "number",
                                                                                       "title":  "累计退款金额（元）",
                                                                                       "description":  "已退还到原支付渠道的累计金额（官方退款会扣手续费，以实际余额变动为准）。自有资金净支出 = 累计充值 − 累计退款 − 当前充值余额。",
                                                                                       "default":  0,
                                                                                       "ui":  {
                                                                                                  "control":  "number"
                                                                                              }
                                                                                   },
                                                                 "holidayDates":  {
                                                                                      "type":  "string",
                                                                                      "title":  "额外节假日（YYYY-MM-DD）",
                                                                                      "description":  "插件已内置 2026 年中国法定节假日。此处可手工补充「按空闲时段计价」的日期（逗号或换行分隔，如 2026-11-11,2026-11-12），用于节假表未覆盖或需要临时调整时；只做补充，不会删除内置日期。",
                                                                                      "default":  ""
                                                                                  }
                                                             }
                                          }
                    }
}