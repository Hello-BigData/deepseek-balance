{
    "manifestVersion":  1,
    "id":  "deepseek-balance",
    "name":  "DeepSeek API 可用余额",
    "version":  "1.16.2",
    "description":  "在侧边栏显示 DeepSeek API 可用余额（总额/充值/赠送）与本机用量（请求次数、Tokens），支持余额预警、充值/退款/赠金自动入账；官网导出的用量包（zip/CSV）可一键同步，用官方数据校正侧栏与详情页的累计与今日消费额（含历史基准补正），用量详情页可把统计导出为 CSV（自选保存目录）。余额仅在查询瞬间读取官方接口，API Key 保存在本机。",
    "minAppVersion":  "0.449.0",
    "trust":  "full-access",
    "capabilities":  [
                         "network.fetch",
                         "resource.write"
                     ],
    "permissions":  [
                        "usage.read"
                    ],
    "network":  {
                    "allowedHosts":  [
                                         "api.deepseek.com",
                                         "api-docs.deepseek.com"
                                     ],
                    "methods":  [
                                    "GET"
                                ],
                    "defaultTimeoutMs":  10000,
                    "maxResponseBytes":  524288
                },
    "ui":  {
               "hostCapabilities":  [
                                        "external.open",
                                        "resource.pick"
                                    ]
           },
    "contributes":  {
                        "widget":  {
                                       "title":  {
